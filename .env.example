# 복사해서 .env로 사용한다: cp .env.example .env  (.env는 커밋하지 않는다)
# 값을 채워야 하는 항목은 비워 두었다. 예시 값을 그대로 쓰지 않는다.

# MySQL root 비밀번호 (필수)
DB_PASSWORD=

# JWT 서명 키: 32바이트 이상의 무작위 문자열 (필수). 예: openssl rand -hex 32
JWT_SECRET=

# 최초 본사 관리자 계정: 5개를 모두 채우면 본사 관리자가 없을 때 기동 시 한 번 생성한다
HQ_LOGIN_ID=
HQ_PASSWORD=
HQ_MEMBER_NAME=
HQ_EMAIL=
HQ_PHONE_NUMBER=

# 지오코딩/라우팅(Kakao REST API 키). 창고·가맹점 등록과 창고 자동 배정에 필요하다
KAKAO_REST_API_KEY=

# 호스트에 노출할 포트 (기본값은 아래와 같다)
# MYSQL_PORT=3306
# REDIS_PORT=6379
# APP_PORT=8080
